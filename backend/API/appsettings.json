{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=StarterTemplate;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Secret": "StarterTemplate_SuperSecureSecretKey_For_JWT_Authentication_2026_@#9876543210!$",
    "Issuer": "StarterTemplate.API",
    "Audience": "StarterTemplate.Client",
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifeTime": true,
    "ValidateIssuerSigningKey": true,
    "AccessTokenExpireDate": 15,
    "RefreshTokenExpireDate": 30
  },
  "DefaultAdmin": {
    "Email": "admin@corestarter.local",
    "Password": "Admin@123456",
    "FullName": "System Administrator",
    "JobTitle": "Administrator",
    "Department": "IT",
    "AutoSeed": true
  },
  "ProtectedUsers": {
    "Emails": [
      "admin@corestarter.local"
    ]
  },
  "FileStorage": {
    "WebRootRelativeFolder": "uploads",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".webp"
    ],
    "GeneralSubfolder": "general",
    "DocumentsSubfolder": "documents",
    "AvatarsSubfolder": "avatars"
  },
  "Email": {
    "Enabled": false,
    "SmtpHost": "",
    "SmtpPort": 587,
    "UseSsl": true,
    "UserName": "",
    "Password": "",
    "DefaultFromAddress": "noreply@localhost",
    "DefaultFromName": "Starter Template"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.Builder.WebApplication": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss ",
        "UseUtcTimestamp": false
      }
    }
  },
  "AllowedHosts": "*"
}
